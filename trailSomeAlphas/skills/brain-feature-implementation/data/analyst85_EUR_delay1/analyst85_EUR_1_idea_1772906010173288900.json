    "template": "trade_when(less(days_from_last_change(winsorize(vec_skewness(vec_filter({version}, value=\"nan\")), std=4)), 5), ts_zscore(winsorize(vec_skewness(vec_filter({version}, value=\"nan\")), std=4), 60), 0)",
