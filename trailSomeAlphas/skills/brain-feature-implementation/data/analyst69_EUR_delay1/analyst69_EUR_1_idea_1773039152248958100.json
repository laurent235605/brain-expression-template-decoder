        "multiply(signed_power(group_zscore(winsorize(days_from_last_change(anl69_eps_expected_report_dt), std=4), industry), 2), signed_power(group_zscore(winsorize(ts_delta(days_from_last_change(anl69_eps_expected_report_dt), 5), std=4), industry), 1))"
