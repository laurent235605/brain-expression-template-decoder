    "template": "if_else(greater(min(min(group_zscore(winsorize(ts_backfill({factor_e},63),std=4),industry), group_zscore(winsorize(ts_backfill({factor_s},63),std=4),industry)), group_zscore(winsorize(ts_backfill({factor_g},63),std=4),industry)), 1.0), add(add(group_zscore(winsorize(ts_backfill({factor_e},63),std=4),industry), group_zscore(winsorize(ts_backfill({factor_s},63),std=4),industry)), group_zscore(winsorize(ts_backfill({factor_g},63),std=4),industry)), if_else(less(max(max(group_zscore(winsorize(ts_backfill({factor_e},63),std=4),industry), group_zscore(winsorize(ts_backfill({factor_s},63),std=4),industry)), group_zscore(winsorize(ts_backfill({factor_g},63),std=4),industry)), -0.5), reverse(add(add(group_zscore(winsorize(ts_backfill({factor_e},63),std=4),industry), group_zscore(winsorize(ts_backfill({factor_s},63),std=4),industry)), group_zscore(winsorize(ts_backfill({factor_g},63),std=4),industry))), multiply(0.2, add(add(group_zscore(winsorize(ts_backfill({factor_e},63),std=4),industry), group_zscore(winsorize(ts_backfill({factor_s},63),std=4),industry)), group_zscore(winsorize(ts_backfill({factor_g},63),std=4),industry))))))",
