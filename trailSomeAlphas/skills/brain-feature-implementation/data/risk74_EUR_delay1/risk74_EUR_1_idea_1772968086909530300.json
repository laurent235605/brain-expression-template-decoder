        "quantile( rsk74_concentration, \"gaussian\" ) * quantile( liquidity_factor_crowding, \"gaussian\" )",
        "quantile( rsk74_concentration, \"gaussian\" ) * quantile( liquidity_timeseries_crowding, \"gaussian\" )",
        "quantile( rsk74_raw_concentration, \"gaussian\" ) * quantile( rsk74_raw_crowding, \"gaussian\" )",
